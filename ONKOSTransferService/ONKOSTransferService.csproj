<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>ONKOSTransferService</RootNamespace>
    <AssemblyName>ONKOS.TransferService</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Configuration.Install" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="ProjectInstaller.cs" />
    <Compile Include="ServiceNotifier.cs" />
    <Compile Include="TransferWindowsService.cs" />
    <Compile Include="..\ONKOSFileTransfer\Network\FileReceiver.cs" Link="FileReceiver.cs" />
    <Compile Include="..\ONKOSFileTransfer\OnkosLogger.cs" Link="OnkosLogger.cs" />
    <Compile Include="..\ONKOSFileTransfer\TransferHistoryStore.cs" Link="TransferHistoryStore.cs" />
  </ItemGroup>
</Project>
